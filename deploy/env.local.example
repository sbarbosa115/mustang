# This account's settings: copy to backend/.env.local, fill in every line, then chmod 600 backend/.env.local.
# It overrides backend/.env (the committed defaults) and is never committed.

APP_ENV=prod
APP_DEBUG=0
# 64 random characters: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
APP_SECRET=

# The address people open, with https. DEFAULT_URI is the same: links in emails are built from it.
APP_URL=https://crm.example.com
DEFAULT_URI=https://crm.example.com

# cPanel › MySQL Databases (or MariaDB): the database, its user, and the user added to the database with ALL PRIVILEGES.
# Encode special characters in the password (@ is %40, # is %23, / is %2F). serverVersion must match the server:
# the deploy script says what to put when it does not.
DATABASE_URL="mysql://cpuser_mustang:PASSWORD@localhost:3306/cpuser_mustang?serverVersion=10.11.19-MariaDB&charset=utf8mb4"

# Encrypts what Mustang keeps secret in the database. 32 random bytes, base64:
#   php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
# Keep a copy somewhere safe: losing it loses what it encrypted, and changing it later does the same.
MUSTANG_ENCRYPTION_KEY=

# Email: cPanel › Email Accounts, then that mailbox's "Connect Devices" for the SMTP host and port. Encode the
# password as in DATABASE_URL. MAIL_FROM should be that mailbox, or replies and deliverability suffer.
MAILER_DSN=smtp://crm%40example.com:PASSWORD@mail.example.com:465
MAIL_FROM="Mustang <crm@example.com>"

# The queue lives in the database; the cron line the deploy script prints works through it.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Texting: only "fake" exists until a carrier is integrated. With it a text shows as sent but never leaves the server.
MESSAGING_SMS_TRANSPORT=fake

# Two-step sign-in is always on in production; this line changes nothing there.
MUSTANG_MFA_REQUIRED=1

# Minutes before an untouched new lead counts as fumbled on the manager's queue.
WORKLIST_FUMBLED_MINUTES=30

# Only behind a proxy or CDN in front of Apache (Cloudflare and the like): its addresses, comma separated.
# TRUSTED_PROXIES=
